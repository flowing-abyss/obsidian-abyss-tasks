{
  "description": "Project-local Superpowers bootstrap, CodeGraph prompt context, and pnpm policy.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.ai/hooks/inject-superpowers.mjs\"",
            "commandWindows": "powershell -NoProfile -Command \"node (Join-Path (git rev-parse --show-toplevel) '.ai/hooks/inject-superpowers.mjs')\"",
            "async": false,
            "timeout": 10,
            "statusMessage": "Loading superpowers skill-check instructions"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.ai/hooks/block-npm-commands.mjs\"",
            "commandWindows": "powershell -NoProfile -Command \"node (Join-Path (git rev-parse --show-toplevel) '.ai/hooks/block-npm-commands.mjs')\"",
            "timeout": 10,
            "statusMessage": "Enforcing pnpm policy"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.ai/codegraph.mjs\" prompt-hook",
            "commandWindows": "powershell -NoProfile -Command \"node (Join-Path (git rev-parse --show-toplevel) '.ai/codegraph.mjs') prompt-hook\"",
            "timeout": 30,
            "statusMessage": "Loading CodeGraph context"
          }
        ]
      }
    ]
  }
}
