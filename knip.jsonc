{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "test/**/*.test.ts",
    "*.mjs",
    ".ai/**/*.mjs",
    "tooling/performance/cli.mts",
    "tooling/performance/native.ts",
  ],
  // Generated by the task-search-worker esbuild plugin, not an npm dependency.
  "ignoreDependencies": ["abyss-task-search-worker"],
  "project": [
    "src/**/*.ts",
    "test/**/*.ts",
    "*.mjs",
    "*.mts",
    "tooling/*.mjs",
    "tooling/performance/**/*.ts",
    "tooling/performance/**/*.mts",
    ".ai/**/*.mjs",
  ],
  "include": ["files", "dependencies", "unlisted", "unresolved", "exports", "types", "duplicates"],
}
