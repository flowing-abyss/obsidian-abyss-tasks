{
  "name": "obsidian-abyss-tasks",
  "version": "1.2.0",
  "private": true,
  "description": "A task management interface for Markdown tasks.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "pnpm typecheck && node esbuild.config.mjs production",
    "build:analyze": "pnpm typecheck && node esbuild.config.mjs production analyze",
    "preversion": "pnpm run verify && node release-check.mjs --release-ready",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "postversion": "git push --follow-tags",
    "release": "pnpm version --tag-version-prefix ''",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "lint:css": "stylelint '**/*.css'",
    "typecheck": "tsc -noEmit --skipLibCheck",
    "test": "vitest run",
    "test:unit": "pnpm test",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "coverage": "pnpm test:coverage",
    "bench": "vitest run --config vitest.bench.config.ts --reporter=verbose",
    "deadcode": "knip",
    "arch": "depcruise src --config dependency-cruiser.config.cjs --output-type err-long",
    "audit:dependencies": "pnpm audit --audit-level moderate",
    "release:artifacts": "node release-artifacts.mjs",
    "release:check": "node release-check.mjs",
    "verify:task": "pnpm lint && pnpm typecheck && pnpm test",
    "test:ai": "node --test \".ai/**/*.test.mjs\"",
    "verify": "pnpm format:check && pnpm lint && pnpm lint:css && pnpm typecheck && pnpm arch && pnpm deadcode && pnpm test:ai && pnpm test:coverage && pnpm build && pnpm release:artifacts && pnpm release:check && pnpm audit:dependencies",
    "ci": "pnpm verify",
    "prepare": "husky && node .ai/setup.mjs"
  },
  "nano-staged": {
    "*.{ts,mts,cts,js,mjs,cjs}": [
      "eslint --max-warnings 0 --no-warn-ignored --fix",
      "prettier --write"
    ],
    "*.css": [
      "stylelint --fix",
      "prettier --write"
    ],
    "*.{json,jsonc,yml,yaml,md}": [
      "prettier --write"
    ]
  },
  "release": {
    "mainJsBudgetBytes": 827392,
    "stylesCssBudgetBytes": 147456
  },
  "keywords": [
    "obsidian",
    "plugin",
    "calendar",
    "tasks"
  ],
  "author": "flowing-abyss",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git@github.com:flowing-abyss/obsidian-abyss-tasks.git"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0",
    "pnpm": ">=11"
  },
  "dependencies": {
    "rrule": "2.8.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@commitlint/types": "^21.2.0",
    "@csstools/selector-specificity": "6.0.0",
    "@eslint/js": "^9.39.5",
    "@eslint/json": "^0.14.0",
    "@types/jsdom": "30.0.0",
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "5.0.0",
    "cssnano": "8.0.10",
    "dependency-cruiser": "18.2.0",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-obsidianmd": "0.4.2",
    "eslint-plugin-sonarjs": "^4.2.0",
    "globals": "17.12.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "jsdom": "^30.0.1",
    "knip": "6.34.0",
    "nano-staged": "^1.0.2",
    "obsidian": "1.13.1",
    "obsidian-test-mocks": "5.0.0",
    "postcss": "8.5.26",
    "postcss-selector-parser": "7.1.5",
    "prettier": "^3.9.6",
    "prettier-plugin-organize-imports": "^4.3.0",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0",
    "vitest": "5.0.0"
  }
}
