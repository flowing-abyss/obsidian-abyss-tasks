{
  "name": "obsidian-abyss-tasks",
  "version": "2.0.1",
  "private": true,
  "description": "A task management interface for Markdown tasks.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "pnpm typecheck && node esbuild.config.mjs production",
    "build:analyze": "pnpm typecheck && node esbuild.config.mjs production analyze",
    "preversion": "pnpm run verify && node release-check.mjs --release-ready",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "postversion": "git push --follow-tags",
    "release": "pnpm version --tag-version-prefix ''",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "lint:css": "stylelint styles.css && node tooling/check-css.mjs styles.css",
    "lint:store": "vitest run --config vitest.store.config.ts",
    "typecheck": "tsc -noEmit --skipLibCheck && tsc --project tooling/tsconfig.json",
    "test": "vitest run",
    "test:unit": "pnpm test",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "coverage": "pnpm test:coverage",
    "bench": "vitest run --config vitest.bench.config.ts --reporter=verbose",
    "deadcode": "knip",
    "arch": "depcruise src --config dependency-cruiser.config.cjs --output-type err-long",
    "audit:dependencies": "pnpm audit --audit-level moderate",
    "release:artifacts": "node release-artifacts.mjs",
    "release:check": "node release-check.mjs",
    "verify:task": "pnpm lint && pnpm lint:css && pnpm typecheck && pnpm arch && pnpm test",
    "test:ai": "node --test \".ai/**/*.test.mjs\"",
    "verify": "pnpm format:check && pnpm lint && pnpm lint:css && pnpm lint:store && pnpm typecheck && pnpm arch && pnpm deadcode && pnpm test:ai && pnpm test:coverage && pnpm build && pnpm release:artifacts && pnpm lint:css:artifact && pnpm release:check && pnpm audit:dependencies",
    "ci": "pnpm verify",
    "prepare": "husky && node .ai/setup.mjs && pnpm run codegraph:setup",
    "lint:css:artifact": "node tooling/check-css.mjs --artifact dist/styles.css",
    "codegraph:setup": "node .ai/setup-codegraph.mjs"
  },
  "nano-staged": {
    "*.{ts,cts,mts,tsx,js,cjs,mjs,jsx}": [
      "eslint --max-warnings 0 --no-warn-ignored --fix",
      "prettier --write"
    ],
    "*.css": [
      "stylelint --fix",
      "prettier --write"
    ],
    "*.{json,jsonc,yml,yaml,md}": [
      "prettier --write"
    ]
  },
  "release": {
    "mainJsBudgetBytes": 1507328,
    "stylesCssBudgetBytes": 181248
  },
  "keywords": [
    "obsidian",
    "plugin",
    "calendar",
    "tasks"
  ],
  "author": "flowing-abyss",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git@github.com:flowing-abyss/obsidian-abyss-tasks.git"
  },
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0",
    "pnpm": ">=12"
  },
  "dependencies": {
    "minisearch": "7.2.0",
    "rrule": "2.8.1"
  },
  "devDependencies": {
    "@colbymchenry/codegraph": "1.6.1",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@commitlint/types": "21.2.3",
    "@csstools/selector-specificity": "6.0.0",
    "@eslint/js": "^9.39.5",
    "@eslint/json": "^0.14.0",
    "@projectwallace/stylelint-plugin": "0.7.0",
    "@types/jsdom": "30.0.0",
    "@types/node": "24.19.1",
    "@vitest/coverage-v8": "5.0.3",
    "cssnano": "9.1.2",
    "dependency-cruiser": "18.5.0",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-obsidianmd": "0.4.2",
    "eslint-plugin-sonarjs": "4.2.2",
    "globals": "17.13.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "jsdom": "30.1.1",
    "knip": "6.39.0",
    "nano-staged": "^1.0.2",
    "obsidian": "1.13.1",
    "obsidian-test-mocks": "7.1.0",
    "postcss": "8.5.28",
    "postcss-selector-parser": "7.1.6",
    "postcss-value-parser": "4.2.0",
    "prettier": "3.9.9",
    "prettier-plugin-organize-imports": "^4.3.0",
    "stylelint": "17.16.0",
    "stylelint-config-obsidianmd": "0.1.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-declaration-block-no-ignored-properties": "3.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  }
}
